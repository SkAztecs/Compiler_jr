// Cloudflare Workers settings: `npm run build` makes dist/, then `npx wrangler deploy`
// uploads it with server/worker.js, which runs the AI tutor. The name must match the
// Worker's name in the Cloudflare dashboard.
{
  "name": "compiler-jr",
  "main": "server/worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  }
}
