# Settings for the AI tutor ("Explain" buttons).
# Copy this file to .env.local, put your key there, and restart `npm run dev`.
# .env.local is never committed to Git (see .gitignore), so the key stays on your computer.

# Your Anthropic API key, from https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional: the Claude model (default claude-haiku-5-5, the cheapest)
# TUTOR_MODEL=claude-haiku-5-5

# Optional: the most explanations per day (default 300)
# TUTOR_DAILY_LIMIT=300

# Optional: an access code people must type before the tutor answers them.
# Useful on a public website, so only people you give the code to can use your key.
# TUTOR_ACCESS_CODE=
